# Example inventory for the split-deployment VM. In real use this file is
# GENERATED by Terraform (infra/terraform/vm.tf's local_file.
# ansible_inventory, from infra/terraform/ansible/inventory.yml.tftpl) as
# infra/ansible/inventory.yml — gitignored, never hand-edited, never
# committed. This .example file exists only so a reader of this repo can
# see the shape without having to run `terraform apply` first.
#
# The host is addressed by its tailnet MagicDNS name, not a public IPv4.
# Port 22 is closed; the VM joins the tailnet at first boot and Ansible (and
# any operator) reaches it over `tailscale ssh` — see infra/terraform/vm.tf's
# firewall comment and infra/README.md's prerequisites.
all:
  hosts:
    aztec-announce-fsn1: # replace with the real Hetzner server name (var.hcloud_location)
      ansible_user: root
      # Hetzner's automount path for the attached data volume — see
      # hcloud_volume.announce_data in infra/terraform/vm.tf. The
      # `docker` role's RequiresMountsFor drop-in and the `volume_mount`
      # role both key off this value.
      data_mount: /mnt/HC_Volume_12345678

# --- BEFORE RUNNING ansible-playbook, on the host itself -------------------
# This playbook deliberately does NOT create or template
# /opt/announce/.env (see roles/compose_up/tasks/main.yml's comment on
# why: it is a real secret file, not something safe to generate from
# Ansible variables checked into this repo). Create it by hand once, on
# the host, before the first `ansible-playbook -i inventory.yml site.yml`
# run:
#
#   tailscale ssh root@aztec-announce-fsn1
#   mkdir -p /opt/announce
#   cat > /opt/announce/.env <<'EOF'
#   POSTGRES_PASSWORD=<openssl rand -base64 32>
#   ANNOUNCE_DOMAIN=db.announce.aztec.network
#   ANNOUNCE_SIGNAL_SECRET=<openssl rand -base64 32 — MUST match the
#     Netlify app's SIGNAL_API_SECRET env var, see src/core/signal-auth.ts>
#   SIGNAL_ACCOUNT=<the registered Signal number, e.g. +15551234567 —
#     leave the value empty (SIGNAL_ACCOUNT=) if Signal is not configured
#     yet. Only the signal-receive container reads this; db, signal,
#     caddy and backup all start regardless, and signal-receive just
#     restart-loops until a number is set. See infra/DEPLOY.md step 3.>
#   BACKUP_ENCRYPTION_KEY=<openssl rand -base64 32 — REQUIRED, no empty
#     option. Backups must never run unencrypted, so this fails the whole
#     stack rather than degrading, unlike the three S3 variables below.>
#   BACKUP_S3_BUCKET=<your bucket — leave empty (BACKUP_S3_BUCKET=) if no
#     off-host backup destination exists yet. Only the backup container
#     reads this and the two AWS_* vars below; db, signal, caddy and
#     signal-receive all start regardless, and backup just restart-loops
#     until all three are set. See infra/DEPLOY.md step 3.>
#   BACKUP_S3_ACCESS_KEY_ID=<... — leave empty together with the other two
#     S3 variables, or fill in all three together>
#   BACKUP_S3_SECRET_ACCESS_KEY=<... — same as above>
#   # optional, see docker-compose.split.yml for defaults:
#   # BACKUP_S3_ENDPOINT=
#   # BACKUP_S3_PREFIX=
#   # ALERT_EMAIL_TO=
#   # ESP_PROVIDER=
#   # EMAIL_FROM=
#   # EMAIL_FROM_NAME="Aztec Announcements"
#   # BREVO_API_KEY=
#   EOF
#   chmod 600 /opt/announce/.env
#
# QUOTE ANY VALUE CONTAINING A SPACE — EMAIL_FROM_NAME
# above is the example that actually needs it. This file is read two
# ways: docker compose's own KEY=VALUE parser (tolerant of unquoted
# spaces) AND, on a cert-reload failure,
# infra/ansible/roles/cert_reload/templates/cert-reload.sh.j2's
# alert_human() sources it as literal shell (`. .env`) to reach
# ALERT_EMAIL_TO/ESP_PROVIDER for the alert email. Under shell sourcing,
# an unquoted `EMAIL_FROM_NAME=Aztec Announcements` parses as
# EMAIL_FROM_NAME=Aztec followed by a stray `Announcements` command —
# confirmed directly — silently truncating the value. Quoting works for
# both readers; leaving it unquoted only works for one of them.
#
# THIS IS A SECRET FILE. Never commit it, never echo its contents into
# Ansible output, never store a copy of it in this repo.

# Local Terraform state (see versions.tf — state is local until this repo
# graduates to the Foundation org and switches to the S3 backend). State can
# contain sensitive values; never commit it.
*.tfstate
*.tfstate.*

# Provider plugin cache only. The lock file (.terraform.lock.hcl) is
# deliberately NOT ignored — Terraform's own convention is to commit it, so
# the operator's `terraform init` resolves the exact hcloud/local provider builds
# this was validated against (hcloud v1.68.0), not whatever `~> 1.49` floats
# to by the time he applies.
.terraform/

# Real variable values (tokens, real CIDRs). The .example file IS committed.
*.tfvars
!*.tfvars.example

# Rendered Ansible inventory (contains the real public IP once applied).
ansible/inventory.yml

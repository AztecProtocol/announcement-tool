# Copy to terraform.tfvars and fill in real values. terraform.tfvars is
# git-ignored — never commit it. Prefer TF_VAR_hcloud_token as an env var
# over putting the token in this file at all, if your shell setup allows it.

# Hetzner Cloud API token for the project this VM is created in.
hcloud_token = "REPLACE_ME"

# SSH public key for this VM. Break-glass only now (Hetzner console access
# if the tailnet join fails) — day-2 operator access is `tailscale ssh`, not
# this key directly. Must be DIFFERENT key material from any other module's
# ssh_public_key applied into the same Hetzner project (Hetzner rejects
# duplicate fingerprints).
ssh_public_key = "ssh-ed25519 AAAA... REPLACE_ME"

# REQUIRED, no default. The tailnet this VM joins on first boot.
tailnet = "example.com"

# PREREQUISITE: tag:announce must already exist in that tailnet's ACL,
# added by rpc.aztec.foundation/tailscale.tf in AztecProtocol/foundation-iac
# and applied BEFORE this module. See variables.tf `tailscale_acl_tag` for
# what happens if this is skipped. Usually left at its default.
# tailscale_acl_tag = "tag:announce"

# Optional overrides (defaults shown in variables.tf are usually fine):
# hcloud_location      = "fsn1"
# server_type          = "cx22"
# image                = "ubuntu-24.04"
# data_volume_size_gb  = 20
# domain               = "db.announce.aztec.network"

# Copy to terraform.tfvars and fill in real values. terraform.tfvars is
# git-ignored — never commit it. Prefer TF_VAR_hcloud_token as an env var
# over putting the token in this file at all, if your shell setup allows it.

# Hetzner Cloud API token for the project this VM is created in.
hcloud_token = "REPLACE_ME"

# SSH public key for this VM. Must be DIFFERENT key material from any other
# module's ssh_public_key applied into the same Hetzner project (Hetzner
# rejects duplicate fingerprints).
ssh_public_key = "ssh-ed25519 AAAA... REPLACE_ME"

# REQUIRED, no default. CIDR(s) allowed to reach port 22 — there is no
# tailnet here, so this is the real (and only) SSH path in. Never set this
# to 0.0.0.0/0.
operator_ssh_cidrs = ["203.0.113.4/32"]

# Optional overrides (defaults shown in variables.tf are usually fine):
# hcloud_location      = "fsn1"
# server_type          = "cx22"
# image                = "ubuntu-24.04"
# data_volume_size_gb  = 20
# domain               = "announce.aztec.network"

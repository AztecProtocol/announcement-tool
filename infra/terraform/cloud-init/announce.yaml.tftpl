#cloud-config
hostname: ${hostname}
fqdn: ${hostname}

# Minimal first-boot bootstrap, mirroring rpc.aztec.foundation and the
# aztec-observability sibling: join the tailnet so Ansible and operators can
# reach the host over `tailscale ssh`. Postgres (5432) and Caddy (443) stay
# on the public internet — Netlify's functions cannot join a tailnet — so
# this join is for operator/Ansible access only, not for the application
# ports Netlify depends on.

package_update: true
package_upgrade: true

packages:
  - curl
  - ca-certificates
  - gnupg
  - lsb-release

runcmd:
  - "curl -fsSL https://tailscale.com/install.sh | sh"
  - "tailscale up --authkey=${tailscale_auth_key} --ssh --hostname=${hostname}"

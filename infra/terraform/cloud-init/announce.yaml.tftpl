#cloud-config
hostname: ${hostname}
fqdn: ${hostname}

# Minimal first-boot bootstrap. Unlike aztec-observability, this does NOT
# join a tailnet — there is no tailnet on this deployment (decided
# 2026-08-27). The only day-1 requirement is that the host is reachable over
# SSH (restricted to var.operator_ssh_cidrs by the Terraform firewall) so
# Ansible can install Postgres, signal-cli-rest-api, and Caddy.

package_update: true
package_upgrade: true

packages:
  - curl
  - ca-certificates
  - gnupg
  - lsb-release

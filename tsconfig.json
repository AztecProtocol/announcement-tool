{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    // TypeScript 7's NodeNext resolver can't find subpath imports like
    // `next/navigation` in packages without an "exports" map (next@16.2.12
    // has none) — it only checks ancestor node_modules for a literal
    // `next/navigation` package folder, never the sibling .d.ts file. This
    // paths mapping is a targeted workaround, not a resolution-mode change.
    //
    // `next/headers` deliberately has NO entry here: adding one (any target,
    // any key syntax — tried exact and wildcard) makes Turbopack's *runtime*
    // resolver silently bind the import to `undefined` in dev, even though
    // `tsc --noEmit` type-checks fine. Reproduced with a minimal probe page
    // doing nothing but `typeof headers` — 500/undefined with the paths entry,
    // working with it removed. Files that need `headers()` import it from the
    // internal `next/dist/server/request/headers.js` path instead (see
    // app/admin/layout.tsx and app/admin/actions.ts) to sidestep this.
    "paths": {
      "next/navigation": ["./node_modules/next/navigation.d.ts"]
    }
  },
  "include": [
    "src",
    "test",
    "app",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

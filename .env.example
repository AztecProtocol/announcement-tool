DATABASE_URL=postgres://announce:announce@127.0.0.1:5499/announce
# Do NOT put sslmode= or sslrootcert= on DATABASE_URL above — postgres.js reads
# those directly out of the URL and they would bypass the two variables below
# entirely (see src/db/connect.ts). Startup refuses to build a connection if
# either is present in the URL's query string.

# TLS to Postgres. Leave both unset for a private link (loopback, Tailscale,
# the docker-compose network) — that is the default for local dev and the
# VM/Tailscale deployment. Set DATABASE_SSL_MODE=verify-full (with
# DATABASE_SSL_ROOT_CERT pointing at the CA bundle) whenever the database is
# reachable over a network you do not otherwise trust, e.g. the split
# deployment where the Hetzner VM's Postgres port is exposed to the public
# internet. "require" is NOT accepted: it encrypts but does not verify the
# server, so it stops eavesdropping and not an active attacker — startup
# refuses to start with it set. Unset DATABASE_SSL_ROOT_CERT with
# DATABASE_SSL_MODE=verify-full also refuses to start, rather than silently
# falling back to the system trust store.
DATABASE_SSL_MODE=
DATABASE_SSL_ROOT_CERT=

# Not a secret. Which deployment shape this process is running under: "vm"
# (the Tailscale/VM deployment) or "netlify" (the Netlify deployment — see
# README.md). REQUIRED in production. This decides which
# admin-identity source is trusted (Tailscale header vs. verified Auth0 JWT)
# and which of the checks below applies. An unset or unrecognized value
# fails startup closed rather than skipping the checks.
# This file configures an APPLICATION process (the web app or the worker).
# On the split deployment, that is Netlify, and the value is `netlify`, set in
# the Netlify UI rather than here. Do not set DEPLOY_TARGET on the VM: the VM
# runs Postgres, Signal and Caddy only, and none of them reads it. The VM's own
# .env holds the compose variables listed in infra/README.md.
# Left commented so copying this file cannot silently select the wrong shape.
# DEPLOY_TARGET=vm

# --- Production startup checks -------------------------------------------
# Both the web app and the worker (or, on the Netlify shape, the
# tick-background function) refuse to start unless ADMIN_EMAIL,
# DEPLOY_TARGET, PUBLIC_BASE_URL, and the deploy-target-specific check below
# meet the production requirements, and at least one row exists in the
# `publishers` table (seed with `npm run seed:publisher -- you@example.com`).
# These checks run ALWAYS, regardless of NODE_ENV, unless
# ANNOUNCE_ALLOW_INSECURE_DEV=1 is set below. They are deliberately not keyed
# on NODE_ENV=production: `next start` only DEFAULTS NODE_ENV to production
# (it does not override an existing value), so NODE_ENV=staging would
# otherwise silently disable every check while the app served admin traffic.
#
# HOSTNAME must be 127.0.0.1 or ::1 unless the checks are disabled below.
# Only checked when DEPLOY_TARGET=vm. Unset, the server binds every
# interface, and admin identity comes from a Tailscale proxy header that is
# forgeable by anyone who can reach the port — loopback plus `tailscale
# serve` in front is what makes that header trustworthy. Not used at all on
# the Netlify shape (DEPLOY_TARGET=netlify), where admin identity instead
# comes from a verified Auth0 JWT — see the AUTH0_* variables below.
HOSTNAME=127.0.0.1

# Disables the four production safety checks above (ADMIN_EMAIL, HOSTNAME,
# PUBLIC_BASE_URL, publishers table). FOR LOCAL DEVELOPMENT ONLY. The only
# accepted value is the exact string "1". This must NEVER be set on a
# deployed instance — doing so removes the only thing enforcing that the
# forgeable Tailscale identity header is safe to trust.
ANNOUNCE_ALLOW_INSECURE_DEV=1

# Base URL used in every link the tool generates (confirmation, unsubscribe,
# manage-preferences, canonical announcement pages, feeds). MUST match where this
# instance is actually reachable, or the links you send point at the wrong host.
# In production this must be set and must start with https:// — unset, it
# defaults to a compiled-in host, so links sent to real subscribers point at
# the wrong site.
# Production: https://announce.aztec.network
# Local dev:  http://localhost:3000
# Test server: http://<server-ip>:3000
PUBLIC_BASE_URL=https://announce.aztec.network
# Which channels this deployment fans out to (comma-separated).
# Leave this UNSET (commented out, as below) to get all five channels —
# webhook, discord, telegram, email, signal. That is the default for a
# fresh `cp .env.example .env` on a local/VM checkout, matching the README.
# An unknown name refuses to start rather than being ignored, so a typo
# cannot silently disable a channel.
# A Netlify deployment MUST set this explicitly, without "signal" (no
# signal-cli sidecar there) — the startup guard refuses to start otherwise.
# Example for a local checkout that wants Signal off too:
# ENABLED_CHANNELS=webhook,discord,telegram,email

# Discord/Telegram/Signal destinations live in channel_settings rows, not here.
TELEGRAM_BOT_TOKEN=
# If 8080 is taken on this machine, set SIGNAL_HOST_PORT to a free port (e.g. 8180)
# and change SIGNAL_API_BASE to match it.
SIGNAL_HOST_PORT=8080
SIGNAL_API_BASE=http://127.0.0.1:8080
SIGNAL_ACCOUNT=
# Shared secret sent as the x-announce-signal-secret header on every request
# to the signal-cli-rest-api sidecar. Leave UNSET for the same-Docker-network
# VM deployment (main) — the sidecar is unreachable from outside there, so no
# secret is needed and none is sent. REQUIRED on the split deployment, where
# a Caddy proxy in front of the publicly-reachable sidecar checks this header
# and rejects any request without it — that proxy is the actual security
# boundary; this value only has to MATCH what the proxy is configured with.
# THIS IS A SECRET: use a long random value in production; placeholder only
# here, never a real value.
SIGNAL_API_SECRET=
# ESP_PROVIDER: console (default) | resend (dev) | brevo (prod)
ESP_PROVIDER=console
EMAIL_FROM=
EMAIL_FROM_NAME=Aztec Announcements
RESEND_API_KEY=
BREVO_API_KEY=

# --- Netlify shape only (DEPLOY_TARGET=netlify) ---------------------------
# Not read at all when DEPLOY_TARGET=vm.

# Provisioned automatically by the Netlify Auth0 extension; not a secret on
# its own (it is a public tenant identifier, not a bearer credential), but do
# not put a real tenant domain here — placeholder only. Used to derive the
# expected JWT issuer (https://<domain>/) if AUTH0_ISSUER is unset.
AUTH0_DOMAIN=

# Provisioned automatically by the Netlify Auth0 extension; not a secret.
# Used as the expected JWT audience if AUTH0_AUDIENCE is unset.
AUTH0_CLIENT_ID=

# Expected JWT audience. Not a secret. Takes precedence over AUTH0_CLIENT_ID
# if both are set. Required (directly or via AUTH0_CLIENT_ID) for
# middleware.ts to verify admin requests on Netlify.
AUTH0_AUDIENCE=

# Expected JWT issuer. Not a secret. Takes precedence over the value derived
# from AUTH0_DOMAIN if both are set. Required (directly or via AUTH0_DOMAIN)
# for middleware.ts to verify admin requests on Netlify.
AUTH0_ISSUER=

# Auth0 application client secret, used by app/admin/callback/route.ts to
# exchange the authorization code for tokens at POST /oauth/token. Required
# for the browser login flow (a confidential/regular-web-app client using
# client_secret_post). THIS IS A SECRET: it authenticates this application to
# your Auth0 tenant. Set it in the Netlify UI, never here. Placeholder only —
# NEVER commit a real value.
AUTH0_CLIENT_SECRET=

# Signing key for the browser session cookie (src/core/session.ts, HS256).
# Required for the browser login flow. THIS IS A SECRET, and it is the ONLY
# thing standing between an attacker and a forged admin identity: anyone who
# learns it can mint a session cookie for any address and become the second
# approver on a `critical` announcement, which fires an IRREVERSIBLE Discord
# role ping. Use a long random value (32+ bytes, e.g.
# `openssl rand -base64 32`). Placeholder only — NEVER commit a real value.
SESSION_SECRET=

# Optional. Set to exactly "1" to make /admin/logout ALSO end the Auth0 tenant
# session via /v2/logout, instead of only clearing the local session cookie.
# Off by default because it requires PUBLIC_BASE_URL (with a trailing slash) to
# be registered in the application's Allowed Logout URLs in the Auth0
# dashboard; without that registration Auth0 refuses the redirect. Not a secret.
AUTH0_LOGOUT_REDIRECT=

# Shared secret that authenticates the internal call from the Netlify
# tick-scheduled function to tick-background — that endpoint is public HTTP
# with nothing else in front of it, so this is the only thing stopping
# anyone who finds the URL from forcing repeated fan-out ticks. Only used by
# the Netlify functions, not the VM worker. THIS IS A SECRET: use a long
# random value in production; placeholder only here. Unset or empty refuses
# every request rather than allowing them.
TICK_SECRET=

# Dev-only admin identity, used when no Tailscale header (VM shape) or
# verified Auth0 identity (Netlify shape) is present.
# In production a real identity source supplies identity and this stays unset.
# MUST BE EMPTY IN PRODUCTION: if set, any request that arrives without a
# Tailscale header or verified Auth0 token is treated as this user and may
# publish. The startup check refuses to start rather than run with this set
# in production.
ADMIN_EMAIL=

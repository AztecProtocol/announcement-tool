DATABASE_URL=postgres://announce:announce@127.0.0.1:5499/announce

# --- Production startup checks -------------------------------------------
# Both the web app and the worker refuse to start unless ADMIN_EMAIL,
# HOSTNAME, and PUBLIC_BASE_URL below meet the production requirements, and
# at least one row exists in the `publishers` table (seed with
# `npm run seed:publisher -- you@example.com`).
# These checks run ALWAYS, regardless of NODE_ENV, unless
# ANNOUNCE_ALLOW_INSECURE_DEV=1 is set below. They are deliberately not keyed
# on NODE_ENV=production: `next start` only DEFAULTS NODE_ENV to production
# (it does not override an existing value), so NODE_ENV=staging would
# otherwise silently disable every check while the app served admin traffic.
#
# HOSTNAME must be 127.0.0.1 or ::1 unless the checks are disabled below.
# Unset, the server binds every interface, and admin identity comes from a
# Tailscale proxy header that is forgeable by anyone who can reach the port —
# loopback plus `tailscale serve` in front is what makes that header
# trustworthy.
HOSTNAME=127.0.0.1

# Disables the four production safety checks above (ADMIN_EMAIL, HOSTNAME,
# PUBLIC_BASE_URL, publishers table). FOR LOCAL DEVELOPMENT ONLY. The only
# accepted value is the exact string "1". This must NEVER be set on a
# deployed instance — doing so removes the only thing enforcing that the
# forgeable Tailscale identity header is safe to trust.
ANNOUNCE_ALLOW_INSECURE_DEV=1

# Base URL used in every link the tool generates (confirmation, unsubscribe,
# manage-preferences, canonical announcement pages, feeds). MUST match where this
# instance is actually reachable, or the links you send point at the wrong host.
# In production this must be set and must start with https:// — unset, it
# defaults to a compiled-in host, so links sent to real subscribers point at
# the wrong site.
# Production: https://announce.aztec.foundation
# Local dev:  http://localhost:3000
# Test server: http://<server-ip>:3000
PUBLIC_BASE_URL=https://announce.aztec.foundation
# Discord/Telegram/Signal destinations live in channel_settings rows, not here.
TELEGRAM_BOT_TOKEN=
# If 8080 is taken on this machine, set SIGNAL_HOST_PORT to a free port (e.g. 8180)
# and change SIGNAL_API_BASE to match it.
SIGNAL_HOST_PORT=8080
SIGNAL_API_BASE=http://127.0.0.1:8080
SIGNAL_ACCOUNT=
# ESP_PROVIDER: console (default) | resend (dev) | brevo (prod)
ESP_PROVIDER=console
EMAIL_FROM=
EMAIL_FROM_NAME=Aztec Announcements
RESEND_API_KEY=
BREVO_API_KEY=

# Shared secret that authenticates the internal call from the Netlify
# tick-scheduled function to tick-background — that endpoint is public HTTP
# with nothing else in front of it, so this is the only thing stopping
# anyone who finds the URL from forcing repeated fan-out ticks. Only used by
# the Netlify functions, not the VM worker. MUST be a long random value in
# production; unset or empty refuses every request rather than allowing them.
TICK_SECRET=

# Dev-only admin identity, used when no Tailscale proxy header is present.
# In production the tailnet supplies identity and this stays unset.
# MUST BE EMPTY IN PRODUCTION: if set, any request that arrives without a
# Tailscale header is treated as this user and may publish. The startup
# check refuses to start rather than run with this set in production.
ADMIN_EMAIL=
